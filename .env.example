# Copy this file to .env.local for local development
# (Vite loads .env.local automatically; Vercel uses its own
# Environment Variables settings in the project dashboard instead —
# see README.md for exact steps).

# Required for every AI feature (market research, photo identification,
# quotation extraction/audit, voice interpretation, AI re-check):
# a Groq API key. Get one at https://console.groq.com -> API Keys.
# This is read ONLY by the serverless function in api/groq.js — it is
# never sent to or used by the browser.
GROQ_API_KEY=

# Optional. Only needed if you use the in-app "Import from Sheets" tab
# to pull data from a Google Sheet via the Sheets API. This is entered
# directly in the app's UI (Import from Sheets tab) at runtime, NOT read
# from an environment variable.
# GOOGLE_SHEETS_API_KEY=not-used-as-an-env-var-see-in-app-settings
